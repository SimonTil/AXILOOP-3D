<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
    <!-- AXILOOP-3D: own app ID, name, developer, links, description and brand colours -->
    <id>com.axiloop3d.AXILOOP3D</id>
    <launchable type="desktop-id">com.axiloop3d.AXILOOP3D.desktop</launchable>
    <name>AXILOOP-3D</name>
    <summary>Axiloop's slicer for FDM 3D printers, based on OrcaSlicer</summary>
    <developer id="com.axiloop3d">
        <name>Axiloop</name>
    </developer>
    <url type="homepage">https://www.axiloop3d.com/</url>
    <url type="help">https://www.orcaslicer.com/wiki</url>
    <url type="bugtracker">https://github.com/SimonTil/AXILOOP-3D/issues/</url>
    <url type="vcs-browser">https://github.com/SimonTil/AXILOOP-3D</url>
    <metadata_license>0BSD</metadata_license>
    <project_license>AGPL-3.0-only</project_license>
    <content_rating type="oars-1.1" />
    <requires>
        <display_length compare="gt">768</display_length>
    </requires>
    <recommends>
        <control>keyboard</control>
        <control>pointing</control>
    </recommends>
    <!-- TODO: replace the OrcaSlicer screenshots and release list with AXILOOP-3D's own at the first release -->
    <screenshots>
        <screenshot type="default">
            <image>https://raw.githubusercontent.com/OrcaSlicer/OrcaSlicer/v2.3.2/scripts/flatpak/images/1.png</image>
            <caption>A model ready to be sliced on a buildplate.</caption>
        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/OrcaSlicer/OrcaSlicer/v2.3.2/scripts/flatpak/images/2.png</image>
            <caption>A calibration test ready to be printed out.</caption>
        </screenshot>
    </screenshots>
    <description>
        <p>AXILOOP-3D is Axiloop's free and open-source slicer for FDM 3D printers. It is based on
            OrcaSlicer and offers the same features, including advanced calibration tools, adaptive
            layer heights, tree supports and multi-material support.</p>
    </description>
    <branding>
        <color type="primary" scheme_preference="light">#1F3B73</color>
        <color type="primary" scheme_preference="dark">#3B62AE</color>
    </branding>
    <releases>
        <release version="2.4.2" date="2026-07-26">
            <url type="details">https://www.orcaslicer.com/wiki/releases/release_2_4_2</url>
            <description>
                <p>See the release page for detailed changelog of OrcaSlicer 2.4.2 release.</p>
            </description>
        </release>
        <release version="2.4.1" date="2026-06-26">
            <url type="details">https://www.orcaslicer.com/wiki/releases/release_2_4_1</url>
            <description>
                <p>See the release page for detailed changelog of OrcaSlicer 2.4.1 release.</p>
            </description>
        </release>
        <release version="2.4.0" date="2026-06-20">
            <url type="details">https://www.orcaslicer.com/wiki/releases/release_2_4_0</url>
            <description>
                <p>See the release page for detailed changelog of OrcaSlicer 2.4.0 release.</p>
            </description>
        </release>
        <release version="2.3.2" date="2025-03-23">
            <url type="details">https://github.com/OrcaSlicer/OrcaSlicer/releases/tag/v2.3.2</url>
            <description>
                <p>See the release page for detailed changelog.</p>
            </description>
        </release>
    </releases>
</component>
