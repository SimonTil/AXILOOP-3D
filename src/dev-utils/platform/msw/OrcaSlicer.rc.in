// AXILOOP-3D: own version as comma-separated numbers (Windows ignores the dotted form), company and exe name
1 VERSIONINFO
FILEVERSION @AXILOOP_VERSION_MAJOR@,@AXILOOP_VERSION_MINOR@,@AXILOOP_VERSION_PATCH@,0
PRODUCTVERSION @AXILOOP_VERSION_MAJOR@,@AXILOOP_VERSION_MINOR@,@AXILOOP_VERSION_PATCH@,0
{
 BLOCK "StringFileInfo"
 {
  BLOCK "040904E4"
  {
   VALUE "CompanyName", "Axiloop"
   VALUE "FileDescription", "@SLIC3R_APP_NAME@"
   VALUE "FileVersion", "@AXILOOP_VERSION@"
   VALUE "ProductName", "@SLIC3R_APP_NAME@"
   VALUE "ProductVersion", "@AXILOOP_VERSION@"
   VALUE "InternalName", "@SLIC3R_APP_NAME@"
   VALUE "LegalCopyright", ""
   VALUE "OriginalFilename", "axiloop-3d.exe"
  }
 }
 BLOCK "VarFileInfo"
 {
   VALUE "Translation", 0x409, 1252
 }
}
2 ICON "@SLIC3R_RESOURCES_DIR@/images/OrcaSlicer.ico"
1 24 "OrcaSlicer.manifest"
